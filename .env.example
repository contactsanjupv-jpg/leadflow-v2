# ---- Backend (Rust) ----
# Runtime connection: the least-privilege xflow_app role (RLS applies to it).
DATABASE_URL=postgres://xflow_app:CHANGE_ME_IN_PRODUCTION@127.0.0.1/xflow_dev
BIND_ADDR=0.0.0.0:8080
SESSION_TTL_HOURS=168
# Comma-separated browser origins allowed by CORS. Leave EMPTY when using the Next.js proxy (default).
CORS_ALLOWED_ORIGINS=
STORAGE_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400
# Paddle webhook signing secret (notification destination secret). Empty => webhook rejects everything.
PADDLE_WEBHOOK_SECRET=
PADDLE_SIGNATURE_TOLERANCE_SECS=300
# When true, running reconciliations/monitoring requires an active/trialing/past_due subscription.
BILLING_ENFORCEMENT=true
WORKER_ENABLED=true
WORKER_POLL_SECS=5
MONITOR_INTERVAL_SECS=900
# Text-layer PDF extraction uses poppler's pdftotext (installed in the Docker image). No OCR.
PDF_EXTRACTION_ENABLED=true
PDFTOTEXT_PATH=pdftotext
RUST_LOG=info

# ---- Migrations (privileged role; NOT used by the running app) ----
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1/xflow_dev
XFLOW_APP_PASSWORD=

# ---- Web (Next.js) ----
API_INTERNAL_URL=http://127.0.0.1:8080
# Paddle checkout (client-side, public): from Paddle > Developer tools. PADDLE_ENV is sandbox or production.
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_ENV=sandbox
# Set to 1 ONLY for local http:// testing of a production build (cookies are Secure otherwise).
INSECURE_COOKIES=

# ---- docker-compose ----
POSTGRES_PASSWORD=
